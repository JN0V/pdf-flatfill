# Descriptions carry personal data and live next to their PDF, never here.
*.toml
!example.toml

# Working PDFs: never in the repository
*.pdf
__pycache__/

# Test tooling state — regenerated by npm and the test runs
tests/e2e/node_modules/
tests/e2e/.artifacts/
tests/e2e/test-results/
tests/e2e/playwright-report/

# Agent tooling and BMAD — fully ignored, output included. Raw BMAD output is
# session material, not documentation: if a spec is worth keeping, it gets
# extracted and consolidated into a real document under version control,
# never committed as-is from _bmad-output/.
.claude/
_bmad/
_bmad-output/
.bmad-loop/
