#!/usr/bin/env python3
"""Fill a non-interactive PDF by laying text, check marks and images onto it.

The what (coordinates and values) lives in a TOML description file; the how
lives here. See README.md for the format and the pitfalls.

A description lives next to the PDF it fills, and its paths are relative to
itself. The pair is meaningless apart: the description names a source PDF and
addresses coordinates on its pages, so keeping the two together is what makes a
folder reproducible on its own.
"""

import argparse
import sys
import tomllib
from pathlib import Path

DEFAULT_INK = (0.05, 0.15, 0.7)   # ink blue
DEFAULT_FONT = "helv"
DEFAULT_SIZE = 10


def die(message):
    print(f"fill-pdf: {message}", file=sys.stderr)
    raise SystemExit(1)


def human_size(n):
    for unit in ("B", "KB", "MB"):
        if n < 1024 or unit == "MB":
            return f"{n} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def load_form(path):
    if not path.is_file():
        die(f"description not found: {path}")
    try:
        with path.open("rb") as handle:
            return tomllib.load(handle)
    except tomllib.TOMLDecodeError as exc:
        die(f"{path} is not valid TOML: {exc}")


def get_page(doc, entry, kind, index):
    """Page numbers are 1-indexed in a description.

    That is deliberately the opposite of the PyMuPDF API: you write a
    description while looking at the PDF in a viewer, where the first page is
    numbered 1.

    With doc=None (a dry run without PyMuPDF) only the shape is checked, not
    whether the page exists in the PDF.
    """
    number = entry.get("page")
    if number is None:
        die(f"[[{kind}]] #{index}: missing 'page' field")
    if not isinstance(number, int) or number < 1:
        die(f"[[{kind}]] #{index}: 'page' must be an integer >= 1 (got {number!r})")
    if doc is None:
        return None
    if number > doc.page_count:
        die(
            f"[[{kind}]] #{index}: page {number} requested, "
            f"but the PDF only has {doc.page_count}"
        )
    return doc[number - 1]


def require(entry, keys, kind, index):
    missing = [k for k in keys if k not in entry]
    if missing:
        die(f"[[{kind}]] #{index}: missing field(s): {', '.join(missing)}")


def unpack(args):
    """Recreate a description folder from a self-contained filled PDF.

    The names of the embedded files are the paths the description uses,
    relative to itself — extracting them next to the PDF (or into -C) gives
    back a folder that fill-pdf and the web app accept as-is.
    """
    fitz = import_pymupdf(required=True)
    pdf_path = Path(args.form).expanduser()
    if not pdf_path.is_file():
        die(f"PDF not found: {pdf_path}")
    workdir = Path(args.workdir).expanduser() if args.workdir else pdf_path.parent
    if not workdir.is_dir():
        die(f"working directory not found: {workdir}")

    doc = fitz.open(pdf_path)
    names = doc.embfile_names()
    if not names:
        die(f"{pdf_path} contains no embedded files — "
            "was it generated with --embed (or the web app)?")

    # Embedded names come from an arbitrary PDF: never let one write
    # outside the working directory.
    targets = []
    for name in names:
        rel = Path(name)
        if rel.is_absolute() or ".." in rel.parts:
            die(f"embedded file has an unsafe name: {name!r}")
        target = workdir / rel
        if target.exists() and not args.force:
            die(f"{target} already exists. Re-run with --force to overwrite it.")
        targets.append((name, target))

    for name, target in targets:
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(doc.embfile_get(name))
        print(f"Extracted: {target}")
    doc.close()


def import_pymupdf(required):
    """Since PyMuPDF 1.24 the module is named `pymupdf`; `fitz` remains a
    deprecated legacy alias. So we try the modern name first."""
    try:
        import pymupdf
        return pymupdf
    except ImportError:
        try:
            import fitz
            return fitz
        except ImportError:
            if required:
                die(
                    "PyMuPDF is required and missing.\n"
                    "  Debian / Ubuntu : sudo apt install python3-pymupdf\n"
                    "  Elsewhere       : pip install pymupdf inside a venv\n"
                    "  (pip --user fails on PEP 668, and pipx only installs\n"
                    "   applications: the library would stay invisible.)"
                )
            return None


def main():
    parser = argparse.ArgumentParser(
        prog="fill-pdf",
        description="Fill a PDF from a TOML description.",
    )
    parser.add_argument(
        "form",
        help="path to the .toml description",
    )
    parser.add_argument(
        "-C", "--workdir", default=None,
        help="resolve the description's paths against this directory instead "
             "of the directory holding the description",
    )
    parser.add_argument(
        "-n", "--dry-run", action="store_true",
        help="print the plan without writing anything",
    )
    parser.add_argument(
        "-f", "--force", action="store_true",
        help="overwrite the output PDF if it already exists",
    )
    parser.add_argument(
        "-e", "--embed", action="store_true",
        help="embed the description, its source PDF and its assets into the "
             "output, as PDF attachments — the filled PDF then carries "
             "everything needed to edit it again (see --unpack), at the "
             "price of roughly doubling in size",
    )
    parser.add_argument(
        "-u", "--unpack", action="store_true",
        help="FORM is a filled PDF made with --embed (or the web app): "
             "extract the embedded description and assets next to it, "
             "then stop",
    )
    args = parser.parse_args()

    if args.unpack:
        unpack(args)
        return

    form_path = Path(args.form).expanduser()
    form = load_form(form_path)

    # The description sits next to its PDF, so its own directory is the frame
    # of reference. Anchoring on the current directory instead would make the
    # same command succeed or fail depending on where it was typed.
    if args.workdir is None:
        workdir = form_path.parent
    else:
        workdir = Path(args.workdir).expanduser()
        if not workdir.is_dir():
            die(f"working directory not found: {workdir}")

    for key in ("source", "output"):
        if key not in form:
            die(f"{form_path}: missing '{key}' field")

    source = workdir / form["source"]
    output = workdir / form["output"]

    if not source.is_file():
        die(f"source PDF not found: {source}")
    if output.exists() and not args.force and not args.dry_run:
        die(f"{output} already exists. Re-run with --force to overwrite it.")

    style = form.get("style", {})
    ink = tuple(style.get("ink", DEFAULT_INK))
    font = style.get("font", DEFAULT_FONT)
    base_fontfile = style.get("fontfile")
    base_size = style.get("size", DEFAULT_SIZE)

    # A custom font is a file next to the description, like an image. PyMuPDF
    # wants an arbitrary alias for each embedded file; one alias per file.
    font_aliases = {}

    def font_args(entry, kind, index):
        """fontname/fontfile keyword arguments for insert_text.

        An entry with `fontfile` uses that file; an entry with only `font`
        uses that base-14 name; an entry with neither inherits the style,
        file included.
        """
        fontfile = entry.get("fontfile")
        name = entry.get("font")
        if fontfile is None and name is None:
            fontfile, name = base_fontfile, font
        if fontfile is None:
            return {"fontname": name}
        path = workdir / fontfile
        if not path.is_file():
            die(f"[[{kind}]] #{index}: font file not found: {path}")
        alias = font_aliases.setdefault(str(path), f"F{len(font_aliases)}")
        return {"fontname": alias, "fontfile": str(path)}

    texts = form.get("text", [])
    checks = form.get("check", [])
    images = form.get("image", [])

    if not (texts or checks or images):
        die(f"{form_path} describes no [[text]], [[check]] or [[image]]")

    print(f"Description : {form_path}")
    print(f"Source      : {source}")
    print(f"Output      : {output}")
    print(f"Contents    : {len(texts)} text(s), {len(checks)} mark(s), {len(images)} image(s)")

    # Imported late: a dry run must be able to proof-read a description on a
    # machine where PyMuPDF is not installed.
    fitz = import_pymupdf(required=not args.dry_run)
    if fitz is None:
        print("\nPyMuPDF missing: pages will not be checked against the PDF.")

    doc = fitz.open(source) if fitz else None

    # Layer order: images at the bottom, then checks, then texts — a
    # signature's opaque background must not eat the name written next to
    # it. An optional integer `z` overrides it, higher painting later.
    paint_ops = []

    for index, entry in enumerate(texts, 1):
        require(entry, ("x", "y", "text"), "text", index)
        fargs = font_args(entry, "text", index)
        page = get_page(doc, entry, "text", index)
        if not args.dry_run:
            paint_ops.append((entry.get("z", 0), 2, len(paint_ops), lambda
                page=page, entry=entry, fargs=fargs: page.insert_text(
                    fitz.Point(entry["x"], entry["y"]),
                    str(entry["text"]),
                    fontsize=entry.get("size", base_size),
                    color=tuple(entry.get("ink", ink)),
                    **fargs,
                )))

    for index, entry in enumerate(checks, 1):
        require(entry, ("x", "y"), "check", index)
        fargs = font_args(entry, "check", index)
        page = get_page(doc, entry, "check", index)
        if not args.dry_run:
            paint_ops.append((entry.get("z", 0), 1, len(paint_ops), lambda
                page=page, entry=entry, fargs=fargs: page.insert_text(
                    fitz.Point(entry["x"], entry["y"]),
                    entry.get("mark", "X"),
                    fontsize=entry.get("size", base_size),
                    color=tuple(entry.get("ink", ink)),
                    **fargs,
                )))

    for index, entry in enumerate(images, 1):
        require(entry, ("rect", "file"), "image", index)
        rect = entry["rect"]
        if len(rect) != 4:
            die(f"[[image]] #{index}: 'rect' expects 4 values (x0, y0, x1, y1)")
        picture = workdir / entry["file"]
        if not picture.is_file():
            die(f"[[image]] #{index}: file not found: {picture}")
        page = get_page(doc, entry, "image", index)
        if not args.dry_run:
            paint_ops.append((entry.get("z", 0), 0, len(paint_ops), lambda
                page=page, rect=rect, picture=picture, entry=entry: page.insert_image(
                    fitz.Rect(*rect),
                    filename=str(picture),
                    keep_proportion=entry.get("keep_proportion", True),
                    overlay=True,
                )))

    for _z, _rank, _seq, op in sorted(paint_ops, key=lambda o: o[:3]):
        op()

    # --embed makes the output self-contained: the description, the blank
    # source and every asset ride along as PDF embedded files, so the filled
    # PDF alone is enough to edit again (--unpack, or dropped on the web
    # app). The source must come too: the output is flattened, and painting
    # over it again would double every mark. Whoever receives the filled
    # form also receives all of it, notes included — hence an explicit flag.
    if args.embed:
        payload = {form_path.name: form_path, form["source"]: source}
        if base_fontfile:
            payload.setdefault(base_fontfile, workdir / base_fontfile)
        for entry in texts + checks:
            if entry.get("fontfile"):
                payload.setdefault(entry["fontfile"], workdir / entry["fontfile"])
        for entry in images:
            payload.setdefault(entry["file"], workdir / entry["file"])
        print(f"Embedded    : {', '.join(payload)}")
        if not args.dry_run:
            for name, path in payload.items():
                if not path.is_file():
                    die(f"--embed: file not found: {path}")
                doc.embfile_add(name, path.read_bytes(), filename=name)

    if args.dry_run:
        if doc:
            doc.close()
        print("\nDry run: nothing was written.")
        return

    doc.save(output)
    doc.close()
    # The size is worth showing: with --embed the output roughly doubles.
    print(f"\nWritten: {output} ({human_size(output.stat().st_size)})")


if __name__ == "__main__":
    main()
